 bool isVowel(char ch){
        return ch == 'a' || ch == 'e' || ch == 'i' ||
               ch == 'o' || ch == 'u';
     }

    int maxVowels(string s, int k) {
        int n = s.size();
        int left = 0;
        int maxVowel = 0;
        int vowel = 0;

        for(int right = 0;right < n ; right++){
            if(isVowel(s[right])){
                vowel++;
            }
          if(right - left + 1 > k){
            if(isVowel(s[left])){
                vowel--;
            }
            left++;
          }
          if(right - left + 1 == k){
            maxVowel = max(maxVowel , vowel);
          }
        }
        return maxVowel;
    }
