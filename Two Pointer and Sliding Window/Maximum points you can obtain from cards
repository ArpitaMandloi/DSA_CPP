int maxScore(vector<int>& cardPoints, int k) {
        int n = cardPoints.size();

        int lSum = 0;
        int rSum = 0;
        int maxSum = 0;

        int rIndex = n - 1;

        // First take k cards from left
        for (int i = 0; i < k; i++) {
            lSum += cardPoints[i];
        }

        maxSum = lSum;

        // One by one left card remove
        // and right card add
        for (int i = k - 1; i >= 0; i--) {
            lSum -= cardPoints[i];
            rSum += cardPoints[rIndex];

            rIndex--;

            maxSum = max(maxSum, lSum + rSum);
        }

        return maxSum;
    }
